# --- Temporal / Pulumi (control plane) ---
# Use 127.0.0.1, not localhost: localhost:7233 may resolve to [::1] (Docker Desktop's Temporal extension).
TEMPORAL_HOST=127.0.0.1:7233
# Address fleet machines dial over the tailnet (`tailscale serve` on 7233).
# Defaults to $WARDEN_CONTROL_HOST:7233.
WARDEN_TEMPORAL_FLEET_ADDRESS=
WARDEN_PULUMI_STATE=./state/pulumi
# Absolute path of the local Pulumi backend, e.g. file:///path/to/warden/state/pulumi
PULUMI_BACKEND_URL=
PULUMI_CONFIG_PASSPHRASE=change-me

# --- Modules and results ---
# One folder per module, each with an executable entrypoint.sh
WARDEN_MODULES_DIR=./modules
# Large temporal_* results are written here as JSON
WARDEN_RESULTS_DIR=./state/results

# --- DigitalOcean ---
DIGITALOCEAN_TOKEN=
WARDEN_DO_REGION=nyc3
WARDEN_DO_SIZE=s-1vcpu-1gb
# Optional: account SSH key fingerprint for break-glass console access
# (otherwise derived from WARDEN_SSH_PUBLIC_KEY_FILE, default ~/.ssh/id_rsa.pub)
WARDEN_DO_SSH_FINGERPRINT=

# --- Tailscale ---
# OAuth client with auth_keys + devices:core (write), tagged tag:warden-worker
TAILSCALE_OAUTH_CLIENT_ID=
TAILSCALE_OAUTH_CLIENT_SECRET=
# Tailnet name as shown in the admin console (or "-" for the client's own)
WARDEN_TAILNET=
# MagicDNS suffix, e.g. tail1234.ts.net
WARDEN_TS_SUFFIX=
# This machine's MagicDNS name (fleet machines reach Temporal here)
WARDEN_CONTROL_HOST=

# --- Herdr (hc, the herdr-core CLI behind Herdr.app) ---
WARDEN_HC_BIN=hc
WARDEN_HERDR_APP_BIN=herdr-app

# --- Lifetimes ---
WARDEN_FLEET_MAX_LIFETIME_MIN=120
WARDEN_READY_TIMEOUT_MIN=15
